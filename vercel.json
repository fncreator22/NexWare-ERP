{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm --prefix landing install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/warehouse-erp", "destination": "/warehouse-erp/index.html" },
    { "source": "/warehouse-erp/", "destination": "/warehouse-erp/index.html" },
    { "source": "/warehouse-erp/:path*", "destination": "/warehouse-erp/:path*" },
    { "source": "/:match*", "destination": "/index.html" }
  ]
}
